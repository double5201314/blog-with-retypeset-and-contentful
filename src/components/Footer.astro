---
import { themeConfig } from '@/config'

const { author } = themeConfig.site
const { links, startYear } = themeConfig.footer

const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear
  ? startYear
  : `${startYear}-${currentYear}`
---

<footer
  class="text-3 leading-4.75 font-navbar lg:text-3.5"
  lg="uno-desktop-column bottom-20"
>
  <p>
    {links.map((link, index) => (
      <>
        <a
          class="transition-colors hover:c-primary"
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.name}
        </a>
        {index < links.length - 1 && ' / '}
      </>
    ))}
  </p>

  <p>
    Powered by <a class="transition-colors hover:c-primary" href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
  </p>

  <p>
    © {year} {author}
  </p>
</footer>
