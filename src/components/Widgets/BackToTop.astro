<!-- Sentinel element for scroll detection -->
<div
  id="top-sentinel"
  aria-hidden="true"
  class="pointer-events-none absolute left-0 top-0 h-px w-full"
/>

<button
  id="back-to-top-button"
  aria-label="Back to top"
  class="fixed bottom-8 right-8 h-10 w-10 rounded-full bg-background opacity-0 pointer-events-none translate-y-4 transition-all duration-300 ease-out"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="m-auto h-60% w-60%"
  >
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<script>
let cleanupBackToTop: (() => void) | null = null

function setupBackToTop() {
  cleanupBackToTop?.()

  const sentinel = document.querySelector<HTMLElement>('#top-sentinel')
  const button = document.querySelector<HTMLButtonElement>('#back-to-top-button')

  if (!sentinel || !button)
    return

  const topSentinel: HTMLElement = sentinel
  const topButton: HTMLButtonElement = button

  function update() {
    // Reveal the button once the top of the page has scrolled out of sight
    const isScrolled = topSentinel.getBoundingClientRect().bottom < -window.innerHeight * 0.3
    topButton.classList.toggle('opacity-0', !isScrolled)
    topButton.classList.toggle('pointer-events-none', !isScrolled)
    topButton.classList.toggle('translate-y-4', !isScrolled)
  }

  function scrollToTop() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    })
  }

  topButton.addEventListener('click', scrollToTop)
  window.addEventListener('scroll', update, { passive: true })
  window.addEventListener('resize', update)
  update()

  cleanupBackToTop = () => {
    topButton.removeEventListener('click', scrollToTop)
    window.removeEventListener('scroll', update)
    window.removeEventListener('resize', update)
  }
}

setupBackToTop()
document.addEventListener('astro:before-swap', () => cleanupBackToTop?.())
document.addEventListener('astro:after-swap', setupBackToTop)
</script>
